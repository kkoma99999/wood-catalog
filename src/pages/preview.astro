---
// DESIGN SANDBOX — three UI directions for the wood catalog, stacked and
// labeled so the chosen one can be rolled into the real components. English /
// LTR for clarity; the live site keeps full Arabic + RTL once a direction wins.
// Flat by design per CLAUDE.md: no shadows, no gradients — depth comes from
// the wood photography, color-blocking, type and hairline rules.
import '../styles/global.css';
import { getCollection } from 'astro:content';
import { siteConfig } from '../config/site';

const all = await getCollection('woods');
const order = ['sapele', 'padauk', 'wenge', 'movingui', 'bilinga', 'okoume', 'mahogany', 'azobe', 'ovangkol'];
const featured = all
  .filter((w) => order.includes(w.id))
  .sort((a, b) => order.indexOf(a.id) - order.indexOf(b.id));

const wa = `https://wa.me/${siteConfig.phone}`;
const pad2 = (n: number) => String(n + 1).padStart(2, '0');
---
<!doctype html>
<html lang="en" dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>UI directions — Neem Wood</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700&family=Bricolage+Grotesque:opsz,wght@12..96,400;12..96,600;12..96,800&family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;1,9..144,400&family=Hanken+Grotesk:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap"
    />
  </head>
  <body class="prev-body">
    <!-- direction switcher -->
    <nav class="switch">
      <span class="switch-lead">Choose a direction →</span>
      <a href="#a">A · Editorial Timber</a>
      <a href="#b">B · Showroom Noir</a>
      <a href="#c">C · Spec Grid</a>
    </nav>

    <!-- ============================ OPTION A ============================ -->
    <section id="a" class="opt opt-a">
      <p class="optlabel">Option A — Editorial Timber<span>refined · serif · magazine</span></p>

      <header class="a-hero">
        <div class="a-hero-copy">
          <p class="a-eyebrow">Hardwood specialists — Saudi Arabia &amp; the Gulf</p>
          <h1 class="a-h1">Timber, <em>chosen</em> for the work it will do.</h1>
          <p class="a-lead">
            A curated range of hardwood species, supplied to contractors, joinery shops
            and architects across the Kingdom. Full specs in the open — pricing on WhatsApp.
          </p>
          <div class="a-actions">
            <a href={wa} class="a-btn-solid">Start a chat</a>
            <a href="#a" class="a-btn-line">Browse species</a>
          </div>
        </div>
        <figure class="a-hero-fig">
          <img src={`/woods/${featured[0]?.id}.webp`} alt={featured[0]?.data.nameEn} />
          <figcaption>{featured[0]?.data.nameEn} — {featured[0]?.data.scientificName}</figcaption>
        </figure>
      </header>

      <div class="a-species">
        <div class="a-species-head">
          <h2>Available species</h2>
          <span class="a-eyebrow">{all.length} in the catalog</span>
        </div>
        <div class="a-grid">
          {featured.slice(0, 3).map((w, i) => (
            <a href="#a" class="a-card">
              <span class="a-num">{pad2(i)}</span>
              <div class="a-card-img"><img src={`/woods/${w.id}.webp`} alt={w.data.nameEn} /></div>
              <h3>{w.data.nameEn}</h3>
              <p class="a-sci">{w.data.scientificName}</p>
              <p class="a-apps">{w.data.applications.join(' · ')}</p>
            </a>
          ))}
        </div>
      </div>

      <div class="a-cta">
        <h2>Send us your cut list. We quote the same day.</h2>
        <a href={wa} class="a-btn-solid">Inquire on WhatsApp</a>
      </div>
    </section>

    <!-- ============================ OPTION B ============================ -->
    <section id="b" class="opt opt-b">
      <p class="optlabel optlabel-dark">Option B — Showroom Noir<span>bold · dark · photographic</span></p>

      <header class="b-hero">
        <div class="b-hero-copy">
          <p class="b-eyebrow">Neem Wood</p>
          <h1 class="b-h1">Serious<br />hardwood,<br />delivered.</h1>
          <p class="b-lead">Marine-grade, joinery, flooring and decorative species — stocked and cut to size for projects across KSA.</p>
          <a href={wa} class="b-btn">Start a chat ↗</a>
        </div>
        <figure class="b-hero-fig">
          <img src={`/woods/${featured[2]?.id}.webp`} alt={featured[2]?.data.nameEn} />
        </figure>
      </header>

      <div class="b-species">
        <div class="b-species-head">
          <h2>The range</h2>
          <span class="b-count">{String(all.length).padStart(2, '0')} species</span>
        </div>
        <div class="b-grid">
          {featured.slice(0, 3).map((w) => (
            <a href="#b" class="b-card">
              <div class="b-card-img"><img src={`/woods/${w.id}.webp`} alt={w.data.nameEn} /></div>
              <div class="b-card-bar">
                <div>
                  <h3>{w.data.nameEn}</h3>
                  <p>{w.data.scientificName}</p>
                </div>
                <span class="b-tag">{w.data.inStock ? 'In stock' : 'By order'}</span>
              </div>
            </a>
          ))}
        </div>
      </div>

      <div class="b-cta">
        <h2>Tell us what you're building.</h2>
        <a href={wa} class="b-btn">Inquire on WhatsApp ↗</a>
      </div>
    </section>

    <!-- ============================ OPTION C ============================ -->
    <section id="c" class="opt opt-c">
      <p class="optlabel">Option C — Spec Grid<span>swiss · technical · data-forward</span></p>

      <header class="c-hero">
        <div class="c-hero-main">
          <p class="c-eyebrow">[ Hardwood supply / KSA + Gulf ]</p>
          <h1 class="c-h1">Multiple hardwood species, specified and ready to supply.</h1>
        </div>
        <dl class="c-meta">
          <div><dt>Catalog</dt><dd>{String(all.length).padStart(2, '0')} species</dd></div>
          <div><dt>Buyers</dt><dd>Contractors · Joinery · Architects</dd></div>
          <div><dt>Pricing</dt><dd>via WhatsApp</dd></div>
          <div><dt>Lead time</dt><dd>7–14 days</dd></div>
        </dl>
      </header>

      <div class="c-index">
        <div class="c-index-head">
          <span>Idx</span><span>Species</span><span>Botanical</span><span>Grades</span><span>Applications</span><span></span>
        </div>
        {featured.slice(0, 6).map((w, i) => (
          <a href="#c" class="c-row">
            <span class="c-idx">{pad2(i)}</span>
            <span class="c-name">{w.data.nameEn}</span>
            <span class="c-bot">{w.data.scientificName}</span>
            <span class="c-grades">{w.data.grades.join(', ')}</span>
            <span class="c-apps">{w.data.applications.join(', ')}</span>
            <span class="c-thumb"><img src={`/woods/${w.id}.webp`} alt={w.data.nameEn} /></span>
          </a>
        ))}
      </div>

      <div class="c-cta">
        <div>
          <p class="c-eyebrow">[ Get a quote ]</p>
          <h2>Send dimensions + quantities. Same-day response.</h2>
        </div>
        <a href={wa} class="c-btn">Inquire on WhatsApp →</a>
      </div>
    </section>

    <style>
      /* ---------------------------------------------------------------- base */
      .prev-body {
        margin: 0;
        font-family: 'Hanken Grotesk', sans-serif;
        background: #2A1A0E;
      }
      .opt { scroll-margin-top: 52px; padding-bottom: 4rem; }
      .optlabel {
        position: sticky; top: 52px; z-index: 5;
        margin: 0; padding: 0.6rem 1.5rem;
        font-family: 'JetBrains Mono', monospace; font-size: 0.72rem;
        letter-spacing: 0.12em; text-transform: uppercase;
        background: #F2E8D3; color: #2A1A0E;
        border-bottom: 1px solid #2A1A0E;
        display: flex; gap: 1rem; align-items: baseline;
      }
      .optlabel span { color: #8A7660; letter-spacing: 0.06em; }
      .optlabel-dark { background: #2A1A0E; color: #F5E9D3; border-bottom-color: #5C3317; }
      .optlabel-dark span { color: #8A7660; }

      /* switcher */
      .switch {
        position: sticky; top: 0; z-index: 10;
        display: flex; gap: 1.25rem; align-items: center; flex-wrap: wrap;
        padding: 0.85rem 1.5rem; height: 52px; box-sizing: border-box;
        background: #100a05; color: #F5E9D3;
        font-family: 'JetBrains Mono', monospace; font-size: 0.78rem;
        border-bottom: 1px solid #5C3317;
      }
      .switch-lead { color: #8A7660; }
      .switch a { color: #F5E9D3; text-decoration: none; padding-bottom: 2px; border-bottom: 1px solid transparent; }
      .switch a:hover { border-bottom-color: #25D366; }

      /* =============================================================== OPT A */
      .opt-a { background: #FAF6EE; color: #2A1A0E; }
      .a-eyebrow {
        font-size: 0.72rem; letter-spacing: 0.18em; text-transform: uppercase;
        color: #8A7660; margin: 0;
      }
      .a-hero {
        max-width: 1200px; margin: 0 auto; padding: 5rem 1.5rem 3rem;
        display: grid; grid-template-columns: 1.1fr 0.9fr; gap: 4rem; align-items: center;
      }
      .a-h1 {
        font-family: 'Fraunces', serif; font-weight: 400;
        font-size: clamp(2.6rem, 5vw, 4.6rem); line-height: 1.02;
        letter-spacing: -0.01em; margin: 1.2rem 0 0;
      }
      .a-h1 em { font-style: italic; color: #5C3317; }
      .a-lead { font-size: 1.1rem; line-height: 1.7; color: #3D2817; max-width: 34ch; margin: 1.5rem 0 0; }
      .a-actions { display: flex; gap: 0.9rem; margin-top: 2rem; flex-wrap: wrap; }
      .a-btn-solid {
        background: #25D366; color: #06281a; font-weight: 600;
        padding: 0.85rem 1.6rem; border-radius: 999px; text-decoration: none; font-size: 0.95rem;
      }
      .a-btn-line {
        background: transparent; color: #2A1A0E; font-weight: 500;
        padding: 0.85rem 1.6rem; border-radius: 999px; text-decoration: none;
        border: 1px solid #2A1A0E; font-size: 0.95rem;
      }
      .a-hero-fig { margin: 0; }
      .a-hero-fig img { width: 100%; height: 460px; object-fit: cover; border-radius: 4px; display: block; }
      .a-hero-fig figcaption {
        font-family: 'Fraunces', serif; font-style: italic; font-size: 0.9rem;
        color: #8A7660; margin-top: 0.75rem;
      }
      .a-species { max-width: 1200px; margin: 0 auto; padding: 2rem 1.5rem; }
      .a-species-head {
        display: flex; justify-content: space-between; align-items: baseline;
        border-bottom: 1px solid #2A1A0E; padding-bottom: 1rem;
      }
      .a-species-head h2 { font-family: 'Fraunces', serif; font-weight: 400; font-size: 2rem; margin: 0; }
      .a-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2.5rem; padding-top: 2.5rem; }
      .a-card { text-decoration: none; color: inherit; display: block; position: relative; }
      .a-num {
        font-family: 'JetBrains Mono', monospace; font-size: 0.75rem; color: #8A7660;
        position: absolute; top: 0.6rem; left: 0.6rem; background: #FAF6EE; padding: 0.15rem 0.4rem;
      }
      .a-card-img img { width: 100%; height: 300px; object-fit: cover; border-radius: 3px; display: block; }
      .a-card h3 { font-family: 'Fraunces', serif; font-weight: 400; font-size: 1.5rem; margin: 1rem 0 0; }
      .a-sci { font-family: 'Fraunces', serif; font-style: italic; color: #8A7660; margin: 0.2rem 0 0; }
      .a-apps {
        font-size: 0.72rem; letter-spacing: 0.1em; text-transform: uppercase;
        color: #5C3317; margin: 0.7rem 0 0;
      }
      .a-cta {
        max-width: 1200px; margin: 3rem auto 0; padding: 3.5rem 1.5rem;
        border-top: 1px solid #2A1A0E; text-align: center;
      }
      .a-cta h2 {
        font-family: 'Fraunces', serif; font-weight: 400;
        font-size: clamp(1.8rem, 3.5vw, 2.8rem); margin: 0 auto 1.8rem; max-width: 22ch;
      }

      /* =============================================================== OPT B */
      .opt-b { background: #2A1A0E; color: #F5E9D3; }
      .b-eyebrow {
        font-family: 'JetBrains Mono', monospace; font-size: 0.75rem;
        letter-spacing: 0.22em; text-transform: uppercase; color: #25D366; margin: 0;
      }
      .b-hero {
        display: grid; grid-template-columns: 1fr 1fr; min-height: 78vh; align-items: stretch;
      }
      .b-hero-copy { padding: clamp(3rem, 7vw, 7rem) clamp(1.5rem, 4vw, 4.5rem); align-self: center; }
      .b-h1 {
        font-family: 'Bricolage Grotesque', sans-serif; font-weight: 800;
        font-size: clamp(3rem, 7vw, 6rem); line-height: 0.92; letter-spacing: -0.02em;
        margin: 1.5rem 0 0;
      }
      .b-lead { font-size: 1.1rem; line-height: 1.7; color: #C9B79E; max-width: 36ch; margin: 1.8rem 0 0; }
      .b-btn {
        display: inline-block; margin-top: 2.2rem; background: #25D366; color: #06281a;
        font-weight: 700; padding: 0.95rem 1.8rem; border-radius: 2px; text-decoration: none;
      }
      .b-hero-fig { margin: 0; }
      .b-hero-fig img { width: 100%; height: 100%; min-height: 360px; object-fit: cover; display: block; }
      .b-species { padding: clamp(3rem, 6vw, 5.5rem) clamp(1.5rem, 4vw, 4.5rem); }
      .b-species-head {
        display: flex; justify-content: space-between; align-items: baseline;
        border-bottom: 1px solid #5C3317; padding-bottom: 1.2rem; margin-bottom: 2.5rem;
      }
      .b-species-head h2 {
        font-family: 'Bricolage Grotesque', sans-serif; font-weight: 700;
        font-size: 2.5rem; margin: 0; letter-spacing: -0.01em;
      }
      .b-count { font-family: 'JetBrains Mono', monospace; color: #8A7660; }
      .b-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem; }
      .b-card { text-decoration: none; color: inherit; border: 1px solid #5C3317; }
      .b-card-img img { width: 100%; height: 340px; object-fit: cover; display: block; }
      .b-card-bar {
        display: flex; justify-content: space-between; align-items: center;
        padding: 1.1rem 1.2rem; border-top: 1px solid #5C3317;
      }
      .b-card-bar h3 { font-family: 'Bricolage Grotesque', sans-serif; font-weight: 600; font-size: 1.3rem; margin: 0; }
      .b-card-bar p { font-size: 0.82rem; color: #8A7660; margin: 0.2rem 0 0; font-style: italic; }
      .b-tag {
        font-family: 'JetBrains Mono', monospace; font-size: 0.66rem; text-transform: uppercase;
        letter-spacing: 0.08em; color: #25D366; border: 1px solid #25D366; padding: 0.25rem 0.5rem;
        white-space: nowrap;
      }
      .b-cta {
        display: flex; justify-content: space-between; align-items: center; gap: 2rem; flex-wrap: wrap;
        margin: 0 clamp(1.5rem, 4vw, 4.5rem); padding: 3rem 0; border-top: 1px solid #5C3317;
      }
      .b-cta h2 { font-family: 'Bricolage Grotesque', sans-serif; font-weight: 700; font-size: clamp(1.8rem, 4vw, 3rem); margin: 0; }

      /* =============================================================== OPT C */
      .opt-c { background: #FAF6EE; color: #2A1A0E; }
      .c-eyebrow {
        font-family: 'JetBrains Mono', monospace; font-size: 0.72rem;
        letter-spacing: 0.1em; color: #8A7660; margin: 0;
      }
      .c-hero {
        max-width: 1200px; margin: 0 auto; padding: 4.5rem 1.5rem 2.5rem;
        display: grid; grid-template-columns: 1.6fr 1fr; gap: 3rem; align-items: end;
        border-bottom: 2px solid #2A1A0E;
      }
      .c-h1 {
        font-family: 'Archivo', sans-serif; font-weight: 600;
        font-size: clamp(2.2rem, 4.4vw, 3.8rem); line-height: 1.04; letter-spacing: -0.02em;
        margin: 1rem 0 0; max-width: 18ch;
      }
      .c-meta { margin: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 1.1rem 1.5rem; }
      .c-meta dt {
        font-family: 'JetBrains Mono', monospace; font-size: 0.66rem; text-transform: uppercase;
        letter-spacing: 0.1em; color: #8A7660;
      }
      .c-meta dd { margin: 0.2rem 0 0; font-size: 0.95rem; font-weight: 500; }
      .c-index { max-width: 1200px; margin: 0 auto; padding: 0 1.5rem; }
      .c-index-head, .c-row {
        display: grid;
        grid-template-columns: 48px 1.3fr 1.6fr 1fr 1.6fr 64px;
        gap: 1rem; align-items: center;
      }
      .c-index-head {
        font-family: 'JetBrains Mono', monospace; font-size: 0.66rem; text-transform: uppercase;
        letter-spacing: 0.1em; color: #8A7660; padding: 1rem 0; border-bottom: 1px solid #8A7660;
      }
      .c-row { padding: 1rem 0; border-bottom: 1px solid #EFE3CC; text-decoration: none; color: inherit; transition: background 0.15s; }
      .c-row:hover { background: #F2E8D3; }
      .c-idx { font-family: 'JetBrains Mono', monospace; color: #8A7660; font-size: 0.85rem; }
      .c-name { font-family: 'Archivo', sans-serif; font-weight: 600; font-size: 1.25rem; }
      .c-bot { font-family: 'JetBrains Mono', monospace; font-size: 0.8rem; color: #8A7660; }
      .c-grades, .c-apps { font-size: 0.85rem; color: #3D2817; }
      .c-thumb img { width: 64px; height: 44px; object-fit: cover; border-radius: 2px; display: block; }
      .c-cta {
        max-width: 1200px; margin: 3rem auto 0; padding: 2.5rem 1.5rem;
        border: 2px solid #2A1A0E; display: flex; justify-content: space-between;
        align-items: center; gap: 2rem; flex-wrap: wrap;
      }
      .c-cta h2 { font-family: 'Archivo', sans-serif; font-weight: 600; font-size: clamp(1.4rem, 2.8vw, 2.1rem); margin: 0.4rem 0 0; max-width: 24ch; }
      .c-btn {
        font-family: 'JetBrains Mono', monospace; background: #25D366; color: #06281a; font-weight: 500;
        padding: 0.9rem 1.5rem; text-decoration: none; white-space: nowrap; border-radius: 2px;
      }

      /* ---------------------------------------------------------- responsive */
      @media (max-width: 860px) {
        .a-hero, .b-hero, .c-hero { grid-template-columns: 1fr; gap: 2rem; }
        .a-grid, .b-grid { grid-template-columns: 1fr; }
        .a-hero-fig img { height: 320px; }
        .c-index-head { display: none; }
        .c-row { grid-template-columns: 36px 1fr 56px; row-gap: 0.3rem; }
        .c-bot, .c-grades, .c-apps { grid-column: 2; }
      }
    </style>
  </body>
</html>
