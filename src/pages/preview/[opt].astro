---
// DESIGN SANDBOX (Arabic / RTL) — one direction per route
// (/preview/a · /preview/b · /preview/c) so each opens in its own window.
// Flat per CLAUDE.md: no shadows, no gradients — depth comes from the wood
// photos, color-blocking, type and hairline rules. Arabic display type per
// direction: Amiri (A), Cairo (B), IBM Plex Sans Arabic (C). Letter-spacing is
// kept off Arabic text (it breaks connected letters); Latin codes keep mono.
import '../../styles/global.css';
import { getCollection } from 'astro:content';
import { siteConfig } from '../../config/site';
import { dict, formatNumber } from '../../i18n/utils';

export function getStaticPaths() {
  return [{ params: { opt: 'a' } }, { params: { opt: 'b' } }, { params: { opt: 'c' } }];
}

const { opt } = Astro.params;
const d = dict('ar');
const all = await getCollection('woods');
const order = ['sapele', 'padauk', 'wenge', 'movingui', 'bilinga', 'okoume', 'mahogany', 'azobe', 'ovangkol'];
const featured = all
  .filter((w) => order.includes(w.id))
  .sort((a, b) => order.indexOf(a.id) - order.indexOf(b.id));

const wa = `https://wa.me/${siteConfig.phone}`;
const count = formatNumber(all.length, 'ar');
const pad2 = (n: number) => String(n + 1).padStart(2, '0');
const apps = (w: (typeof featured)[number]) =>
  w.data.applications.map((a) => d.products.detail.applications[a]).join(' · ');
const titles: Record<string, string> = {
  a: 'A · Editorial Timber',
  b: 'B · Showroom Noir',
  c: 'C · Spec Grid',
};
---
<!doctype html>
<html lang="ar" dir="rtl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titles[opt]} — نيم للأخشاب</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Amiri:ital,wght@0,400;0,700;1,400&family=Cairo:wght@400;600;800&family=IBM+Plex+Sans+Arabic:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
    />
  </head>
  <body class:list={['prev-body', `body-${opt}`]}>
    <span class:list={['badge', `badge-${opt}`]}>{titles[opt]}</span>

    {opt === 'a' && (
      <section class="opt-a">
        <header class="a-hero">
          <div class="a-hero-copy">
            <p class="a-eyebrow">متخصّصون في الأخشاب الصلبة — المملكة والخليج</p>
            <h1 class="a-h1">خشبٌ <em>مُنتقى</em> لِما ستصنعه.</h1>
            <p class="a-lead">
              تشكيلة مُنتقاة من الأخشاب الصلبة، نوردها للمقاولين ومشاغل النجارة والمعماريين
              في أنحاء المملكة. كل المواصفات واضحة — والأسعار عبر واتساب.
            </p>
            <div class="a-actions">
              <a href={wa} class="a-btn-solid">ابدأ المحادثة</a>
              <a href="#" class="a-btn-line">تصفّح الأنواع</a>
            </div>
          </div>
          <figure class="a-hero-fig">
            <img src={`/woods/${featured[0]?.id}.webp`} alt={featured[0]?.data.nameAr} />
            <figcaption>{featured[0]?.data.nameAr} <span dir="ltr">— {featured[0]?.data.scientificName}</span></figcaption>
          </figure>
        </header>
        <div class="a-species">
          <div class="a-species-head">
            <h2>الأنواع المتوفرة</h2>
            <span class="a-eyebrow">{count} في الكتالوج</span>
          </div>
          <div class="a-grid">
            {featured.slice(0, 3).map((w, i) => (
              <a href="#" class="a-card">
                <span class="a-num">{pad2(i)}</span>
                <div class="a-card-img"><img src={`/woods/${w.id}.webp`} alt={w.data.nameAr} /></div>
                <h3>{w.data.nameAr}</h3>
                <p class="a-sci" dir="ltr">{w.data.scientificName}</p>
                <p class="a-apps">{apps(w)}</p>
              </a>
            ))}
          </div>
        </div>
        <div class="a-cta">
          <h2>أرسل لنا قائمة القصّ، ونعطيك السعر في نفس اليوم.</h2>
          <a href={wa} class="a-btn-solid">استفسر عبر واتساب</a>
        </div>
      </section>
    )}

    {opt === 'b' && (
      <section class="opt-b">
        <header class="b-hero">
          <div class="b-hero-copy">
            <p class="b-eyebrow">نيم للأخشاب</p>
            <h1 class="b-h1">خشبٌ صلب،<br />يُورَّد<br />باحتراف.</h1>
            <p class="b-lead">أنواع بحرية، ونجارة، وأرضيات، وأخشاب زينة — مخزونة ومقصوصة على المقاس لمشاريع في أنحاء المملكة.</p>
            <a href={wa} class="b-btn">ابدأ المحادثة</a>
          </div>
          <figure class="b-hero-fig">
            <img src={`/woods/${featured[2]?.id}.webp`} alt={featured[2]?.data.nameAr} />
          </figure>
        </header>
        <div class="b-species">
          <div class="b-species-head">
            <h2>التشكيلة</h2>
            <span class="b-count">{count} نوع</span>
          </div>
          <div class="b-grid">
            {featured.slice(0, 3).map((w) => (
              <a href="#" class="b-card">
                <div class="b-card-img"><img src={`/woods/${w.id}.webp`} alt={w.data.nameAr} /></div>
                <div class="b-card-bar">
                  <div>
                    <h3>{w.data.nameAr}</h3>
                    <p dir="ltr">{w.data.scientificName}</p>
                  </div>
                  <span class="b-tag">{w.data.inStock ? d.wood.inStock : d.wood.byOrder}</span>
                </div>
              </a>
            ))}
          </div>
        </div>
        <div class="b-cta">
          <h2>أخبرنا بما تبنيه.</h2>
          <a href={wa} class="b-btn">استفسر عبر واتساب</a>
        </div>
      </section>
    )}

    {opt === 'c' && (
      <section class="opt-c">
        <header class="c-hero">
          <div class="c-hero-main">
            <p class="c-eyebrow">[ توريد الأخشاب الصلبة / المملكة + الخليج ]</p>
            <h1 class="c-h1">أنواع متعددة من الأخشاب الصلبة، موصّفة وجاهزة للتوريد.</h1>
          </div>
          <dl class="c-meta">
            <div><dt>الكتالوج</dt><dd>{count} نوع</dd></div>
            <div><dt>المشترون</dt><dd>مقاولون · نجارة · معماريون</dd></div>
            <div><dt>الأسعار</dt><dd>عبر واتساب</dd></div>
            <div><dt>مدة التوريد</dt><dd>٧–١٤ يوم</dd></div>
          </dl>
        </header>
        <div class="c-index">
          <div class="c-index-head">
            <span>المؤشّر</span><span>النوع</span><span>الاسم العلمي</span><span>الدرجات</span><span>الاستخدامات</span><span></span>
          </div>
          {featured.slice(0, 6).map((w, i) => (
            <a href="#" class="c-row">
              <span class="c-idx">{pad2(i)}</span>
              <span class="c-name">{w.data.nameAr}</span>
              <span class="c-bot" dir="ltr">{w.data.scientificName}</span>
              <span class="c-grades" dir="ltr">{w.data.grades.join(', ')}</span>
              <span class="c-apps">{apps(w)}</span>
              <span class="c-thumb"><img src={`/woods/${w.id}.webp`} alt={w.data.nameAr} /></span>
            </a>
          ))}
        </div>
        <div class="c-cta">
          <div>
            <p class="c-eyebrow">[ اطلب عرض سعر ]</p>
            <h2>أرسل المقاسات والكميات. نرد عليك في نفس اليوم.</h2>
          </div>
          <a href={wa} class="c-btn">استفسر عبر واتساب ←</a>
        </div>
      </section>
    )}

    <style>
      .prev-body { margin: 0; font-family: 'IBM Plex Sans Arabic', sans-serif; line-height: 1.75; }
      .body-a, .body-c { background: #FAF6EE; }
      .body-b { background: #2A1A0E; }
      .badge {
        position: fixed; top: 14px; left: 14px; z-index: 20;
        font-family: 'JetBrains Mono', monospace; font-size: 0.7rem;
        letter-spacing: 0.1em; padding: 0.45rem 0.75rem; border-radius: 2px;
      }
      .badge-a, .badge-c { background: #2A1A0E; color: #F5E9D3; }
      .badge-b { background: #F5E9D3; color: #2A1A0E; }

      /* =============================================================== OPT A */
      .opt-a { color: #2A1A0E; padding-bottom: 4rem; }
      .a-eyebrow { font-size: 0.8rem; color: #8A7660; margin: 0; }
      .a-hero {
        max-width: 1200px; margin: 0 auto; padding: 5rem 1.5rem 3rem;
        display: grid; grid-template-columns: 1.1fr 0.9fr; gap: 4rem; align-items: center;
      }
      .a-h1 {
        font-family: 'Amiri', serif; font-weight: 700;
        font-size: clamp(2.6rem, 5vw, 4.8rem); line-height: 1.2; margin: 1.2rem 0 0;
      }
      .a-h1 em { font-style: normal; color: #5C3317; }
      .a-lead { font-size: 1.15rem; line-height: 1.9; color: #3D2817; max-width: 42ch; margin: 1.5rem 0 0; }
      .a-actions { display: flex; gap: 0.9rem; margin-top: 2rem; flex-wrap: wrap; }
      .a-btn-solid { background: #25D366; color: #06281a; font-weight: 600; padding: 0.85rem 1.6rem; border-radius: 999px; text-decoration: none; font-size: 1rem; }
      .a-btn-line { color: #2A1A0E; font-weight: 500; padding: 0.85rem 1.6rem; border-radius: 999px; text-decoration: none; border: 1px solid #2A1A0E; font-size: 1rem; }
      .a-hero-fig { margin: 0; }
      .a-hero-fig img { width: 100%; height: 460px; object-fit: cover; border-radius: 4px; display: block; }
      .a-hero-fig figcaption { font-family: 'Amiri', serif; font-size: 1rem; color: #8A7660; margin-top: 0.75rem; }
      .a-species { max-width: 1200px; margin: 0 auto; padding: 2rem 1.5rem; }
      .a-species-head { display: flex; justify-content: space-between; align-items: baseline; border-bottom: 1px solid #2A1A0E; padding-bottom: 1rem; }
      .a-species-head h2 { font-family: 'Amiri', serif; font-weight: 700; font-size: 2.2rem; margin: 0; }
      .a-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2.5rem; padding-top: 2.5rem; }
      .a-card { text-decoration: none; color: inherit; display: block; position: relative; }
      .a-num { font-family: 'JetBrains Mono', monospace; font-size: 0.75rem; color: #8A7660; position: absolute; top: 0.6rem; right: 0.6rem; background: #FAF6EE; padding: 0.15rem 0.4rem; }
      .a-card-img img { width: 100%; height: 300px; object-fit: cover; border-radius: 3px; display: block; }
      .a-card h3 { font-family: 'Amiri', serif; font-weight: 700; font-size: 1.7rem; margin: 1rem 0 0; }
      .a-sci { font-family: 'Amiri', serif; font-style: italic; color: #8A7660; margin: 0.2rem 0 0; }
      .a-apps { font-size: 0.85rem; color: #5C3317; margin: 0.6rem 0 0; }
      .a-cta { max-width: 1200px; margin: 3rem auto 0; padding: 3.5rem 1.5rem; border-top: 1px solid #2A1A0E; text-align: center; }
      .a-cta h2 { font-family: 'Amiri', serif; font-weight: 700; font-size: clamp(1.9rem, 3.5vw, 3rem); line-height: 1.4; margin: 0 auto 1.8rem; max-width: 26ch; }

      /* =============================================================== OPT B */
      .opt-b { color: #F5E9D3; padding-bottom: 4rem; }
      .b-eyebrow { font-family: 'Cairo', sans-serif; font-size: 0.95rem; font-weight: 600; color: #25D366; margin: 0; }
      .b-hero { display: grid; grid-template-columns: 1fr 1fr; min-height: 82vh; align-items: stretch; }
      .b-hero-copy { padding: clamp(3rem, 7vw, 7rem) clamp(1.5rem, 4vw, 4.5rem); align-self: center; }
      .b-h1 { font-family: 'Cairo', sans-serif; font-weight: 800; font-size: clamp(3rem, 7vw, 6rem); line-height: 1.1; margin: 1.5rem 0 0; }
      .b-lead { font-size: 1.15rem; line-height: 1.9; color: #C9B79E; max-width: 42ch; margin: 1.8rem 0 0; }
      .b-btn { display: inline-block; margin-top: 2.2rem; background: #25D366; color: #06281a; font-weight: 700; font-family: 'Cairo', sans-serif; padding: 0.95rem 1.8rem; border-radius: 2px; text-decoration: none; }
      .b-hero-fig { margin: 0; }
      .b-hero-fig img { width: 100%; height: 100%; min-height: 360px; object-fit: cover; display: block; }
      .b-species { padding: clamp(3rem, 6vw, 5.5rem) clamp(1.5rem, 4vw, 4.5rem); }
      .b-species-head { display: flex; justify-content: space-between; align-items: baseline; border-bottom: 1px solid #5C3317; padding-bottom: 1.2rem; margin-bottom: 2.5rem; }
      .b-species-head h2 { font-family: 'Cairo', sans-serif; font-weight: 700; font-size: 2.6rem; margin: 0; }
      .b-count { color: #8A7660; }
      .b-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem; }
      .b-card { text-decoration: none; color: inherit; border: 1px solid #5C3317; }
      .b-card-img img { width: 100%; height: 340px; object-fit: cover; display: block; }
      .b-card-bar { display: flex; justify-content: space-between; align-items: center; padding: 1.1rem 1.2rem; border-top: 1px solid #5C3317; }
      .b-card-bar h3 { font-family: 'Cairo', sans-serif; font-weight: 600; font-size: 1.4rem; margin: 0; }
      .b-card-bar p { font-size: 0.82rem; color: #8A7660; margin: 0.2rem 0 0; font-style: italic; }
      .b-tag { font-size: 0.78rem; color: #25D366; border: 1px solid #25D366; padding: 0.25rem 0.6rem; white-space: nowrap; }
      .b-cta { display: flex; justify-content: space-between; align-items: center; gap: 2rem; flex-wrap: wrap; margin: 0 clamp(1.5rem, 4vw, 4.5rem); padding: 3rem 0; border-top: 1px solid #5C3317; }
      .b-cta h2 { font-family: 'Cairo', sans-serif; font-weight: 700; font-size: clamp(1.9rem, 4vw, 3rem); margin: 0; }

      /* =============================================================== OPT C */
      .opt-c { color: #2A1A0E; padding-bottom: 4rem; }
      .c-eyebrow { font-size: 0.8rem; color: #8A7660; margin: 0; }
      .c-hero { max-width: 1200px; margin: 0 auto; padding: 4.5rem 1.5rem 2.5rem; display: grid; grid-template-columns: 1.6fr 1fr; gap: 3rem; align-items: end; border-bottom: 2px solid #2A1A0E; }
      .c-h1 { font-family: 'IBM Plex Sans Arabic', sans-serif; font-weight: 600; font-size: clamp(2.2rem, 4.4vw, 3.6rem); line-height: 1.4; margin: 1rem 0 0; max-width: 22ch; }
      .c-meta { margin: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 1.1rem 1.5rem; }
      .c-meta dt { font-size: 0.78rem; color: #8A7660; }
      .c-meta dd { margin: 0.2rem 0 0; font-size: 1rem; font-weight: 600; }
      .c-index { max-width: 1200px; margin: 0 auto; padding: 0 1.5rem; }
      .c-index-head, .c-row { display: grid; grid-template-columns: 56px 1.3fr 1.6fr 1fr 1.6fr 64px; gap: 1rem; align-items: center; }
      .c-index-head { font-size: 0.78rem; color: #8A7660; padding: 1rem 0; border-bottom: 1px solid #8A7660; }
      .c-row { padding: 1rem 0; border-bottom: 1px solid #EFE3CC; text-decoration: none; color: inherit; transition: background 0.15s; }
      .c-row:hover { background: #F2E8D3; }
      .c-idx { font-family: 'JetBrains Mono', monospace; color: #8A7660; font-size: 0.9rem; text-align: center; }
      .c-name { font-family: 'IBM Plex Sans Arabic', sans-serif; font-weight: 600; font-size: 1.3rem; }
      .c-bot { font-family: 'JetBrains Mono', monospace; font-size: 0.8rem; color: #8A7660; }
      .c-grades { font-family: 'JetBrains Mono', monospace; font-size: 0.82rem; color: #3D2817; }
      .c-apps { font-size: 0.9rem; color: #3D2817; }
      .c-thumb img { width: 64px; height: 44px; object-fit: cover; border-radius: 2px; display: block; }
      .c-cta { max-width: 1200px; margin: 3rem auto 0; padding: 2.5rem 1.5rem; border: 2px solid #2A1A0E; display: flex; justify-content: space-between; align-items: center; gap: 2rem; flex-wrap: wrap; }
      .c-cta h2 { font-family: 'IBM Plex Sans Arabic', sans-serif; font-weight: 600; font-size: clamp(1.4rem, 2.8vw, 2.1rem); line-height: 1.5; margin: 0.4rem 0 0; max-width: 30ch; }
      .c-btn { background: #25D366; color: #06281a; font-weight: 600; padding: 0.9rem 1.5rem; text-decoration: none; white-space: nowrap; border-radius: 2px; }

      @media (max-width: 860px) {
        .a-hero, .b-hero, .c-hero { grid-template-columns: 1fr; gap: 2rem; }
        .a-grid, .b-grid { grid-template-columns: 1fr; }
        .a-hero-fig img { height: 320px; }
        .c-index-head { display: none; }
        .c-row { grid-template-columns: 44px 1fr 56px; row-gap: 0.3rem; }
        .c-bot, .c-grades, .c-apps { grid-column: 2; }
      }
    </style>
  </body>
</html>
