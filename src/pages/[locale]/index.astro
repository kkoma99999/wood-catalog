---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HeroSection from '../../components/home/HeroSection.astro';
import WhyUsSection from '../../components/home/WhyUsSection.astro';
import SpeciesSection from '../../components/home/SpeciesSection.astro';
import CtaSection from '../../components/home/CtaSection.astro';
import type { Locale } from '../../i18n/utils';

export function getStaticPaths() {
  return [
    { params: { locale: 'ar' } },
    { params: { locale: 'en' } },
  ];
}

const locale = Astro.params.locale as Locale;
---
<BaseLayout locale={locale}>
  <HeroSection locale={locale} />
  <WhyUsSection locale={locale} />
  <SpeciesSection locale={locale} />
  <CtaSection locale={locale} />
</BaseLayout>
