---
import { Picture } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import WhatsAppButton from '../../components/WhatsAppButton.astro';
import { dict, pickName, type Locale } from '../../i18n/utils';
import { siteConfig } from '../../config/site';
import heroImg from '../../assets/store/gabon-forest-logs.webp';
import distinctionImg from '../../assets/store/lumber-stacks-closeup.webp';
import visionImg from '../../assets/store/okoume-bundle-saudi-label.webp';

export function getStaticPaths() {
  return [
    { params: { locale: 'ar' } },
    { params: { locale: 'en' } },
  ];
}

const locale = Astro.params.locale as Locale;
const d = dict(locale);
const a = d.about;
const brand = pickName(siteConfig.brand, locale);
---
<BaseLayout locale={locale} title={a.heading} description={a.metaDescription}>
  <!-- Origin: forest photo with the page title color-blocked over a flat tint. -->
  <section class="relative isolate overflow-hidden bg-wood-900">
    <Picture
      src={heroImg}
      formats={['avif', 'webp']}
      fallbackFormat="webp"
      alt={a.images.hero}
      widths={[480, 739]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      decoding="async"
      class="absolute inset-0 -z-10 w-full h-full object-cover"
    />
    <div class="absolute inset-0 -z-10 bg-wood-900/55" aria-hidden="true"></div>
    <div class="max-w-7xl mx-auto px-4 md:px-6 py-20 md:py-28">
      <p class="section-label text-cream-50/70">{brand}</p>
      <h1 class="mt-3 text-3xl md:text-5xl text-cream-50 leading-tight max-w-3xl">{a.heading}</h1>
      <p class="mt-4 text-lg text-cream-50/85 max-w-2xl leading-relaxed">{a.heroLead}</p>
    </div>
  </section>

  <!-- Intro -->
  <section class="bg-cream-50">
    <div class="max-w-3xl mx-auto px-4 md:px-6 py-12 md:py-16 space-y-5 text-lg text-wood-800">
      <p>{a.intro}</p>
      <p>{a.experience}</p>
    </div>
  </section>

  <!-- Figures: credibility at a glance, drawn from the copy's own numbers. -->
  <section class="bg-wood-700 text-cream-light">
    <div class="max-w-7xl mx-auto px-4 md:px-6 py-12 md:py-16 grid grid-cols-1 sm:grid-cols-3 gap-8 text-center">
      {a.stats.map((s) => (
        <div>
          <p class="text-4xl md:text-5xl text-cream-50 font-medium">{s.value}</p>
          <p class="mt-2 text-sm text-cream-light/70">{s.label}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Pull-quote: the philosophy line, elevated for editorial weight. -->
  <section class="bg-cream-50">
    <div class="max-w-3xl mx-auto px-4 md:px-6 py-10 md:py-16">
      <blockquote class="border-s-4 border-wood-700 ps-5 text-2xl md:text-3xl text-wood-900 leading-snug">
        {a.quote}
      </blockquote>
    </div>
  </section>

  <!-- What sets us apart -->
  <section class="bg-cream-100">
    <div class="max-w-7xl mx-auto px-4 md:px-6 py-12 md:py-20 grid gap-8 md:grid-cols-2 md:items-center">
      <Picture
        src={distinctionImg}
        formats={['avif', 'webp']}
        fallbackFormat="webp"
        alt={a.images.distinction}
        widths={[600, 1200]}
        sizes="(min-width: 768px) 50vw, 100vw"
        loading="lazy"
        decoding="async"
        pictureAttributes={{ class: 'block' }}
        class="block w-full aspect-[4/3] object-cover rounded-2xl"
      />
      <div>
        <h2 class="text-2xl md:text-4xl text-wood-900">{a.distinctionTitle}</h2>
        <div class="mt-4 space-y-4 text-wood-800">
          <p>{a.distinctionBody1}</p>
          <p>{a.distinctionBody2}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Where we're headed -->
  <section class="bg-cream-50">
    <div class="max-w-7xl mx-auto px-4 md:px-6 py-12 md:py-20 grid gap-8 md:grid-cols-2 md:items-center">
      <div>
        <h2 class="text-2xl md:text-4xl text-wood-900">{a.visionTitle}</h2>
        <p class="mt-4 text-wood-800">{a.visionBody}</p>
      </div>
      <Picture
        src={visionImg}
        formats={['avif', 'webp']}
        fallbackFormat="webp"
        alt={a.images.vision}
        widths={[480, 739]}
        sizes="(min-width: 768px) 50vw, 100vw"
        loading="lazy"
        decoding="async"
        pictureAttributes={{ class: 'block' }}
        class="block w-full aspect-[4/3] object-cover rounded-2xl"
      />
    </div>
  </section>

  <!-- Close: WhatsApp CTA, with the brand tagline as a small sign-off. -->
  <section class="bg-wood-700 text-cream-light">
    <div class="max-w-7xl mx-auto px-4 md:px-6 py-14 md:py-20 text-center">
      <h2 class="text-2xl md:text-4xl max-w-2xl mx-auto leading-tight">{d.home.darkCta.title}</h2>
      <div class="mt-8 flex justify-center">
        <WhatsAppButton
          variant="primary"
          locale={locale}
          label={d.home.darkCta.cta}
          location="about"
        />
      </div>
      <p class="mt-10 text-sm text-cream-light/60">{a.tagline}</p>
    </div>
  </section>
</BaseLayout>
