---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import WoodCard from '../../../components/product/WoodCard.astro';
import { dict, formatList, pickName, type Locale } from '../../../i18n/utils';

export function getStaticPaths() {
  return [
    { params: { locale: 'ar' } },
    { params: { locale: 'en' } },
  ];
}

const locale = Astro.params.locale as Locale;
const d = dict(locale);
const woods = await getCollection('woods');

// Keep the meta description tied to the live catalog so it never lists
// discontinued species; uses each wood's localized name.
const speciesList = formatList(
  woods.map((wood) => pickName(wood.data, locale)),
  locale,
);
const metaDescription = d.products.list.metaDescription.replace('{species}', speciesList);
---
<BaseLayout
  locale={locale}
  title={d.products.list.metaTitle}
  description={metaDescription}
>
  <section class="bg-cream-50">
    <div class="max-w-7xl mx-auto px-4 md:px-6 pt-8 md:pt-14">
      <p class="section-label text-wood-500">{d.products.list.label}</p>
      <h1 class="mt-2 text-3xl md:text-5xl text-wood-900 leading-tight max-w-3xl">
        {d.products.list.title}
      </h1>
      <p class="mt-4 text-wood-800 max-w-2xl">{d.products.list.subtitle}</p>
    </div>
  </section>
  <section class="bg-cream-50">
    <div class="max-w-7xl mx-auto px-4 md:px-6 pt-8 pb-12 md:pb-20 grid gap-4 md:grid-cols-3">
      {woods.map((wood) => <WoodCard wood={wood} locale={locale} />)}
    </div>
  </section>
</BaseLayout>
