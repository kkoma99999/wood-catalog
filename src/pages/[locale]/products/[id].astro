---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import UsesBadges from '../../../components/product/UsesBadges.astro';
import ProductCtaSection from '../../../components/product/ProductCtaSection.astro';
import SimilarSpecies from '../../../components/product/SimilarSpecies.astro';
import WhatsAppButton from '../../../components/WhatsAppButton.astro';
import { dict, locales, pickName, type Locale } from '../../../i18n/utils';
import { splitLocaleProse, renderProse } from '../../../lib/prose';
import { heroImage, stockPill } from '../../../lib/wood';

export async function getStaticPaths() {
  const woods = await getCollection('woods');
  return locales.flatMap((locale) =>
    woods.map((wood) => ({
      params: { locale, id: wood.id },
      props: { wood },
    })),
  );
}

interface Props {
  wood: CollectionEntry<'woods'>;
}

const { wood } = Astro.props;
const locale = Astro.params.locale as Locale;
const d = dict(locale);
const data = wood.data;
const localeProse = splitLocaleProse(wood.body ?? '', locale);
const proseHtml = localeProse ? renderProse(localeProse) : null;
// Only compile the full MDX body for the rare single-language fallback (no
// ## EN/## AR markers); bilingual entries — the norm — render from proseHtml.
const Content = proseHtml ? null : (await render(wood)).Content;

const hero = heroImage(data.images);
const name = pickName(data, locale);
const { class: pillClass, label: pillLabel } = stockPill(data.inStock, d);

// SEO description draws only from supplied content — the product's own opening
// sentence from its MDX body — rather than any invented marketing copy.
const leadSentence = (localeProse ?? '')
  .split('\n')
  .map((line) => line.trim())
  .find((line) => line.length > 0 && !line.startsWith('**') && !line.startsWith('- '));
const seoDescription = leadSentence ? `${name} — ${leadSentence}` : name;
---
<BaseLayout locale={locale} title={name} description={seoDescription}>
  <article class="max-w-7xl mx-auto px-4 md:px-6 py-6 md:py-10">
    <section data-hero>
      {hero ? (
        <img
          src={hero}
          alt={name}
          loading="eager"
          fetchpriority="high"
          decoding="async"
          class="h-[220px] md:h-[360px] w-full rounded-2xl object-cover"
        />
      ) : (
        <div
          class="h-[220px] md:h-[360px] rounded-2xl"
          style={`background-color: ${data.hexColor}`}
          aria-hidden="true"
        ></div>
      )}
      <div class="mt-6 md:mt-8 md:flex md:items-start md:gap-8">
        <div class="md:flex-1">
          <span class:list={['inline-block text-xs px-2 py-0.5 rounded-full', pillClass]}>
            {pillLabel}
          </span>
          <h1 class="mt-3 text-3xl md:text-5xl text-wood-900 leading-tight">{name}</h1>
        </div>
        <div class="mt-6 md:mt-0 md:ms-auto">
          <WhatsAppButton
            variant="primary"
            locale={locale}
            productName={name}
            productId={wood.id}
            location="detail-hero"
          />
        </div>
      </div>
    </section>

    <section class="mt-10 md:mt-14 max-w-3xl text-wood-800">
      {proseHtml ? <div set:html={proseHtml} /> : Content && <Content />}
    </section>

    <section class="mt-10 md:mt-14">
      <h2 class="text-xl md:text-2xl text-wood-900 mb-4">{d.products.detail.usesTitle}</h2>
      <UsesBadges wood={wood} locale={locale} />
    </section>
  </article>

  <ProductCtaSection locale={locale} productName={name} productId={wood.id} />

  <SimilarSpecies current={wood} locale={locale} />

  <WhatsAppButton
    variant="sticky"
    locale={locale}
    productName={name}
    productId={wood.id}
    label={d.whatsapp.stickyCta}
    location="detail-sticky"
    initiallyHidden
  />

  <script is:inline>
    // CLAUDE.md: only JS on the site, sticky reveal after hero exits viewport.
    (() => {
      const hero = document.querySelector('[data-hero]');
      const sticky = document.querySelector('[data-sticky-cta]');
      if (!hero || !sticky) return;
      const io = new IntersectionObserver(
        (entries) => sticky.toggleAttribute('hidden', entries[0].isIntersecting),
        { threshold: 0 },
      );
      io.observe(hero);
    })();
  </script>
</BaseLayout>
