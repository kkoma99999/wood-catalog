---
import { Picture } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import WhatsAppButton from '../../components/WhatsAppButton.astro';
import WhatsAppIcon from '../../components/icons/WhatsAppIcon.astro';
import { dict, type Locale } from '../../i18n/utils';
import { siteConfig } from '../../config/site';
import headerImg from '../../assets/store/wood-grain-macro.webp';

export function getStaticPaths() {
  return [
    { params: { locale: 'ar' } },
    { params: { locale: 'en' } },
  ];
}

const locale = Astro.params.locale as Locale;
const d = dict(locale);
const c = d.contact;
const telHref = `tel:+${siteConfig.phone}`;
const mailHref = `mailto:${siteConfig.email}`;

// Shared card chrome; phone/email are whole-card links, WhatsApp wraps a button.
const cardClass = 'bg-cream-100 rounded-2xl p-6 flex flex-col gap-3';
const linkCardClass = `${cardClass} border border-transparent transition-colors hover:border-wood-500`;
---
<BaseLayout locale={locale} title={c.heading} description={c.metaDescription}>
  <!-- Grain macro behind the page title, under the same flat tint the other
       heroes use. Abstract texture keeps the focus on the contact cards below. -->
  <section class="relative isolate overflow-hidden bg-wood-900">
    <Picture
      src={headerImg}
      formats={['avif', 'webp']}
      fallbackFormat="webp"
      alt={c.imageAlt}
      widths={[640, 720]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      decoding="async"
      class="absolute inset-0 -z-10 w-full h-full object-cover"
    />
    <div class="absolute inset-0 -z-10 bg-wood-900/65" aria-hidden="true"></div>
    <div class="max-w-7xl mx-auto px-4 md:px-6 py-16 md:py-24">
      <p class="section-label text-cream-50/70">{d.nav.contact}</p>
      <h1 class="mt-2 text-3xl md:text-5xl text-cream-50 leading-tight max-w-3xl">{c.heading}</h1>
      <p class="mt-4 text-cream-50/85 max-w-2xl leading-relaxed">{c.subtitle}</p>
    </div>
  </section>

  <section class="bg-cream-50">
    <div class="max-w-7xl mx-auto px-4 md:px-6 pt-10 md:pt-14 pb-12 md:pb-20 grid gap-4 md:grid-cols-3">
      <!-- WhatsApp — the primary channel -->
      <div class={cardClass}>
        <div class="flex items-center gap-2 text-wood-700">
          <WhatsAppIcon class="w-6 h-6" />
          <p class="section-label text-wood-500">{c.whatsappLabel}</p>
        </div>
        <p class="text-wood-800 text-sm">{c.whatsappHint}</p>
        <div class="mt-auto pt-2">
          <WhatsAppButton variant="primary" locale={locale} location="contact" />
        </div>
      </div>

      <!-- Phone (tel:) -->
      <a href={telHref} data-wa-location="contact-phone" class={linkCardClass}>
        <div class="flex items-center gap-2 text-wood-700">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-6 h-6" aria-hidden="true">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z" />
          </svg>
          <p class="section-label text-wood-500">{c.phoneLabel}</p>
        </div>
        <p class="text-wood-900 text-lg"><span dir="ltr">{siteConfig.phoneDisplay}</span></p>
        <p class="text-wood-800 text-sm">{c.phoneHint}</p>
      </a>

      <!-- Email (mailto:) -->
      <a href={mailHref} data-wa-location="contact-email" class={linkCardClass}>
        <div class="flex items-center gap-2 text-wood-700">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-6 h-6" aria-hidden="true">
            <rect x="3" y="5" width="18" height="14" rx="2" />
            <path d="m3 7 9 6 9-6" />
          </svg>
          <p class="section-label text-wood-500">{c.emailLabel}</p>
        </div>
        <p class="text-wood-900 text-lg break-all"><span dir="ltr">{siteConfig.email}</span></p>
        <p class="text-wood-800 text-sm">{c.emailHint}</p>
      </a>
    </div>
  </section>
</BaseLayout>
