---
import { getCollection } from 'astro:content';
import { dict, type Locale } from '../../i18n/utils';
import WoodCard from '../product/WoodCard.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const d = dict(locale);
const woods = await getCollection('woods');
---
<section class="bg-cream-50">
  <div class="max-w-7xl mx-auto px-4 md:px-6 py-12 md:py-20">
    <h2 class="text-2xl md:text-4xl text-wood-900">{d.home.species.label}</h2>
    <div class="mt-8 grid gap-4 md:grid-cols-3">
      {woods.map((wood) => <WoodCard wood={wood} locale={locale} />)}
    </div>
  </div>
</section>
