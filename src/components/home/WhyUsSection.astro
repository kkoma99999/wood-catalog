---
import { dict, formatNumber, type Locale } from '../../i18n/utils';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const d = dict(locale);
const w = d.home.whyUs;
---
<!-- Value narrative between the hero and the catalog. Numbered, hairline-ruled
     columns keep it flat and editorial (no cards/shadows, per CLAUDE.md). -->
<section class="bg-cream-100">
  <div class="max-w-7xl mx-auto px-4 md:px-6 py-14 md:py-20">
    <p class="section-label text-wood-500">{w.label}</p>
    <h2 class="mt-2 text-2xl md:text-4xl text-wood-900 max-w-2xl leading-tight">{w.title}</h2>
    <div class="mt-10 grid gap-8 md:grid-cols-3">
      {w.items.map((item, i) => (
        <div class="border-t border-cream-200 pt-5">
          <p class="text-2xl text-wood-500 font-medium tabular-nums">
            {formatNumber(String(i + 1).padStart(2, '0'), locale)}
          </p>
          <h3 class="mt-3 text-lg text-wood-900">{item.title}</h3>
          <p class="mt-2 text-sm text-wood-800 leading-relaxed">{item.body}</p>
        </div>
      ))}
    </div>
  </div>
</section>
