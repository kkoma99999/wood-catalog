---
import { Picture } from 'astro:assets';
import { dict, localePath, type Locale } from '../../i18n/utils';
import WhatsAppButton from '../WhatsAppButton.astro';
import heroImg from '../../assets/store/okoume-yard-gabon.webp';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const d = dict(locale);
const browseHref = localePath('/products', locale);
---
<!-- Full-bleed photo hero. astro:assets emits AVIF + WebP with width/height set,
     so there's no layout shift; legibility comes from a flat solid tint (not a
     gradient, per CLAUDE.md). This photo is the LCP image, so it loads eager. -->
<section class="relative isolate overflow-hidden bg-wood-900">
  <Picture
    src={heroImg}
    formats={['avif', 'webp']}
    fallbackFormat="webp"
    alt={d.home.hero.imageAlt}
    widths={[640, 1024]}
    sizes="100vw"
    loading="eager"
    fetchpriority="high"
    decoding="async"
    class="absolute inset-0 -z-10 w-full h-full object-cover"
  />
  <div class="absolute inset-0 -z-10 bg-wood-900/55" aria-hidden="true"></div>
  <div class="max-w-7xl mx-auto px-4 md:px-6 py-20 md:py-32">
    <span class="inline-block bg-cream-50/95 text-wood-700 px-3 py-1 rounded-full section-label">
      {d.home.hero.pill}
    </span>
    <h1 class="mt-5 text-2xl md:text-4xl text-cream-50 leading-tight max-w-3xl">
      {d.home.hero.subtitle}
    </h1>
    <p class="mt-4 text-base md:text-lg text-cream-50/85 max-w-2xl leading-relaxed">
      {d.home.hero.lead}
    </p>
    <div class="mt-7 flex flex-wrap gap-3">
      <WhatsAppButton
        variant="primary"
        locale={locale}
        label={d.home.hero.inquireCta}
        location="hero"
      />
      <a
        href={browseHref}
        class="inline-flex items-center justify-center px-6 h-12 rounded-full border border-cream-50 text-cream-50 font-medium transition-colors hover:bg-cream-50 hover:text-wood-900"
      >
        {d.home.hero.browseCta}
      </a>
    </div>
  </div>
</section>
