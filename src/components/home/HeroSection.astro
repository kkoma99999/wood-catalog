---
import { dict, localePath, type Locale } from '../../i18n/utils';
import WhatsAppButton from '../WhatsAppButton.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const d = dict(locale);
const browseHref = localePath('/products', locale);
---
<section class="bg-cream-50">
  <div class="max-w-7xl mx-auto px-4 md:px-6 pt-8 md:pt-16 pb-12 md:pb-24">
    <span class="inline-block bg-cream-100 text-wood-700 px-3 py-1 rounded-full section-label">
      {d.home.hero.pill}
    </span>
    <p class="mt-5 text-2xl md:text-4xl text-wood-900 leading-tight max-w-3xl">
      {d.home.hero.subtitle}
    </p>
    <div class="mt-7 flex flex-wrap gap-3">
      <WhatsAppButton
        variant="primary"
        locale={locale}
        label={d.home.hero.inquireCta}
        location="hero"
      />
      <a
        href={browseHref}
        class="inline-flex items-center justify-center px-6 h-12 rounded-full border border-wood-700 text-wood-700 font-medium transition-colors hover:bg-wood-700 hover:text-cream-50"
      >
        {d.home.hero.browseCta}
      </a>
    </div>
  </div>
</section>
