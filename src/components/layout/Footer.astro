---
import { dict, pickName, type Locale } from '../../i18n/utils';
import { siteConfig } from '../../config/site';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const d = dict(locale);
const brand = pickName(siteConfig.brand, locale);
---
<footer class="bg-cream-100 text-wood-800 mt-16 pb-24 md:pb-12">
  <div class="max-w-7xl mx-auto px-4 md:px-6 py-10 grid gap-8 md:grid-cols-2">
    <div>
      <img
        src="/logo.webp"
        alt={brand}
        width="373"
        height="320"
        decoding="async"
        class="h-16 w-auto"
      />
      <p class="mt-3 text-sm text-wood-500 max-w-xs">{d.footer.tagline}</p>
    </div>
    <div>
      <p class="section-label text-wood-500">{d.nav.contact}</p>
      <ul class="mt-2 space-y-1 text-sm">
        <li>
          <a href={`tel:+${siteConfig.phone}`} dir="ltr" class="transition-colors hover:text-wood-900">
            {siteConfig.phoneDisplay}
          </a>
        </li>
        <li>
          <a href={`mailto:${siteConfig.email}`} dir="ltr" class="transition-colors hover:text-wood-900 break-all">
            {siteConfig.email}
          </a>
        </li>
      </ul>
    </div>
  </div>
  <div class="border-t border-cream-200">
    {/* Copyright and the commercial registration share the bottom bar — where
        Saudi buyers expect to find the CR. The number stays ASCII and bidi-
        isolated in both locales: it is copied and verified, not read as prose. */}
    <div
      class="max-w-7xl mx-auto px-4 md:px-6 py-4 flex flex-wrap justify-between gap-x-6 gap-y-1 text-xs text-wood-500"
    >
      <p>{d.footer.copyright}</p>
      <p>
        {d.footer.commercialRegistration}
        <bdi dir="ltr" class="tabular-nums tracking-wide">{siteConfig.commercialRegistration}</bdi>
      </p>
    </div>
  </div>
</footer>
