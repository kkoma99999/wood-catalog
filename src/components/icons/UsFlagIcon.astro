---
interface Props {
  class?: string;
}
const { class: cls = 'w-5 h-3.5' } = Astro.props;
---
<svg
  viewBox="0 0 24 16"
  xmlns="http://www.w3.org/2000/svg"
  class:list={[cls, 'rounded-sm overflow-hidden']}
  aria-hidden="true"
>
  <!-- 13 stripes (red field, white bars) -->
  <rect width="24" height="16" fill="#B22234" />
  <g fill="#FFFFFF">
    <rect y="1.23" width="24" height="1.23" />
    <rect y="3.69" width="24" height="1.23" />
    <rect y="6.15" width="24" height="1.23" />
    <rect y="8.62" width="24" height="1.23" />
    <rect y="11.08" width="24" height="1.23" />
    <rect y="13.54" width="24" height="1.23" />
  </g>
  <!-- canton -->
  <rect width="9.6" height="8.62" fill="#3C3B6E" />
  <!-- simplified 3x3 star grid (50 stars unreadable at chip size) -->
  <g fill="#FFFFFF">
    <circle cx="2" cy="2" r="0.55" />
    <circle cx="4.8" cy="2" r="0.55" />
    <circle cx="7.6" cy="2" r="0.55" />
    <circle cx="2" cy="4.3" r="0.55" />
    <circle cx="4.8" cy="4.3" r="0.55" />
    <circle cx="7.6" cy="4.3" r="0.55" />
    <circle cx="2" cy="6.6" r="0.55" />
    <circle cx="4.8" cy="6.6" r="0.55" />
    <circle cx="7.6" cy="6.6" r="0.55" />
  </g>
</svg>
