---
import { dict, type Locale } from '../../i18n/utils';
import WhatsAppButton from '../WhatsAppButton.astro';

interface Props {
  locale: Locale;
  productName: string;
  productCode?: string;
  productId: string;
}
const { locale, productName, productCode, productId } = Astro.props;
const d = dict(locale);
const cta = d.products.detail.productCta;
---
<section class="bg-wood-700 text-cream-light">
  <div class="max-w-7xl mx-auto px-4 md:px-6 py-12 md:py-16 text-center">
    <p class="section-label text-cream-light/70">{cta.label}</p>
    <h2 class="mt-3 text-2xl md:text-4xl max-w-2xl mx-auto leading-tight">{cta.title}</h2>
    <p class="mt-4 text-cream-light/80 max-w-xl mx-auto">{cta.subtitle}</p>
    <div class="mt-6 flex justify-center">
      <WhatsAppButton
        variant="primary"
        locale={locale}
        productName={productName}
        productCode={productCode}
        productId={productId}
        location="detail-dark-cta"
      />
    </div>
  </div>
</section>
