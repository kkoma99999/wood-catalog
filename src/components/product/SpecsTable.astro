---
import type { CollectionEntry } from 'astro:content';
import { dict, type Locale } from '../../i18n/utils';
import { stockPill } from '../../lib/wood';

interface Props {
  wood: CollectionEntry<'woods'>;
  locale: Locale;
}
const { wood, locale } = Astro.props;
const d = dict(locale);
const data = wood.data;
const L = d.products.detail;

// Numbers stay ASCII per CLAUDE.md ("spec tables: keep ASCII for technical readability").
const apps = data.applications.map((a) => L.applications[a]).join(' · ');
const family = L.colorFamilies[data.colorFamily];
const certs = data.certifications.length ? data.certifications.join(', ') : L.certificationsNone;
const stockLabel = stockPill(data.inStock, d).label;

const rows: Array<{ label: string; value: string }> = [
  { label: L.colorFamilyLabel,    value: family },
  { label: L.gradesLabel,         value: data.grades.join(', ') },
  { label: L.applicationsLabel,   value: apps },
  { label: L.certificationsLabel, value: certs },
  { label: L.moqLabel,            value: `${data.moqBoardFeet} ${L.unitBoardFeet}` },
  { label: L.leadTimeLabel,       value: `${data.leadTimeDays} ${L.unitDays}` },
  { label: L.stockLabel,          value: stockLabel },
];
---
<dl class="grid grid-cols-1 md:grid-cols-2 gap-y-3 gap-x-8 text-sm">
  {rows.map(({ label, value }) => (
    <div class="flex justify-between gap-4 border-b border-cream-200 pb-2">
      <dt class="text-wood-500">{label}</dt>
      <dd class="text-wood-900 text-end">{value}</dd>
    </div>
  ))}
</dl>
