---
import type { CollectionEntry } from 'astro:content';
import { dict, type Locale } from '../../i18n/utils';
import ApplicationIcon from '../icons/ApplicationIcon.astro';

interface Props {
  wood: CollectionEntry<'woods'>;
  locale: Locale;
}
const { wood, locale } = Astro.props;
const d = dict(locale);
const L = d.products.detail;
---
<ul class="flex flex-wrap gap-2">
  {wood.data.applications.map((app) => (
    <li class="inline-flex items-center gap-2 px-3 py-2 rounded-full bg-cream-100 text-wood-800 text-sm">
      <ApplicationIcon application={app} class="w-4 h-4 text-wood-700" />
      <span>{L.applications[app]}</span>
    </li>
  ))}
</ul>
