---
import type { CollectionEntry } from 'astro:content';
import { dict, localePath, pickName, type Locale } from '../../i18n/utils';
import { heroImage, stockPill } from '../../lib/wood';

interface Props {
  wood: CollectionEntry<'woods'>;
  locale: Locale;
}
const { wood, locale } = Astro.props;
const data = wood.data;
const d = dict(locale);

const name = pickName(data, locale);
// Secondary line: Arabic cards show the English trade name (more useful to
// Gulf buyers than the Latin binomial); English cards keep the botanical name.
const subtitle = locale === 'ar' ? data.nameEn : data.scientificName;
const { class: pillClass, label: pillLabel } = stockPill(data.inStock, d);
const href = localePath(`/products/${wood.id}`, locale);
const hero = heroImage(data.images);
---
<a
  href={href}
  data-wa-product={wood.id}
  class="group block bg-cream-50 border border-cream-200 rounded-2xl overflow-hidden transition-colors hover:border-wood-500"
>
  <div class="flex md:block">
    {hero ? (
      <img
        src={hero}
        alt={name}
        loading="lazy"
        decoding="async"
        class="w-[90px] md:w-full aspect-square shrink-0 object-cover"
      />
    ) : (
      <div
        class="w-[90px] md:w-full aspect-square shrink-0"
        style={`background-color: ${data.hexColor}`}
        aria-hidden="true"
      ></div>
    )}
    <div class="flex-1 p-4 md:p-5 flex flex-col gap-1.5">
      <div class="flex items-start gap-2">
        <h3 class="text-wood-900 font-medium text-lg leading-tight">{name}</h3>
        <span class:list={['ms-auto text-[11px] px-2 py-0.5 rounded-full whitespace-nowrap', pillClass]}>
          {pillLabel}
        </span>
      </div>
      <p class="text-xs italic text-wood-500" dir="ltr">{subtitle}</p>
    </div>
  </div>
</a>
