---
import { getCollection, type CollectionEntry } from 'astro:content';
import { dict, type Locale } from '../../i18n/utils';
import WoodCard from './WoodCard.astro';

interface Props {
  current: CollectionEntry<'woods'>;
  locale: Locale;
}
const { current, locale } = Astro.props;
const d = dict(locale);
const all = await getCollection('woods');
const currentApps = new Set(current.data.applications);

// Rank others by overlap with the current wood: same colour family + shared
// applications win out. Cap at 3 so the section stays a single row.
const similar = all
  .filter((w) => w.id !== current.id)
  .map((w) => {
    let score = 0;
    if (w.data.colorFamily === current.data.colorFamily) score += 2;
    for (const a of w.data.applications) if (currentApps.has(a)) score += 1;
    return { wood: w, score };
  })
  .sort((a, b) => b.score - a.score)
  .slice(0, 3)
  .map((x) => x.wood);
---
<section class="bg-cream-50">
  <div class="max-w-7xl mx-auto px-4 md:px-6 py-12 md:py-16">
    <h2 class="text-xl md:text-2xl text-wood-900 mb-6">{d.products.detail.similarTitle}</h2>
    <div class="grid gap-4 md:grid-cols-3">
      {similar.map((w) => <WoodCard wood={w} locale={locale} />)}
    </div>
  </div>
</section>
