---
import type { CollectionEntry } from 'astro:content';

type WoodImages = NonNullable<CollectionEntry<'woods'>['data']['images']>;

interface Props {
  hexColor: string;
  images?: WoodImages;
  name?: string;
}
const { hexColor, images, name = '' } = Astro.props;

// Fill slots with real images first (stack → grain → inUse), then pad with
// brightness/saturation tints so the strip stays balanced when fewer than
// four images exist. No box shadows or gradients (CLAUDE.md compliant).
const imageSrcs = [images?.stack, images?.grain, images?.inUse].filter(
  (src): src is string => Boolean(src),
);
const tints = [
  'brightness(1.15)',
  'brightness(0.85)',
  'saturate(0.4)',
  'none',
].slice(0, Math.max(0, 4 - imageSrcs.length));
---
<div class="mt-3 flex gap-2" role="presentation">
  {imageSrcs.map((src) => (
    <img
      src={src}
      alt={name}
      loading="lazy"
      decoding="async"
      class="w-14 h-14 md:w-16 md:h-16 rounded-lg object-cover border border-cream-200"
    />
  ))}
  {tints.map((filter) => (
    <div
      class="w-14 h-14 md:w-16 md:h-16 rounded-lg border border-cream-200"
      style={`background-color: ${hexColor}; filter: ${filter}`}
      aria-hidden="true"
    ></div>
  ))}
</div>
